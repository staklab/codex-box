{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "codex-box",
  "version": "1.2.11",
  "identifier": "com.codexbox.windows",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "codex-box",
        "width": 460,
        "height": 720,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true
      }
    ],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "codex-box Windows 系统托盘伴侣",
    "longDescription": "与 Codex 长期共存的 Windows 系统托盘伴侣",
    "copyright": "Copyright © codex-box contributors",
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"]
      },
      "wix": { "language": ["zh-CN", "en-US"] }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["dreamskin", "codexbox"]
      }
    }
  }
}
